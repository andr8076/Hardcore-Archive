# Hardcore Archive configuration
#
# This is the REAL default configuration for this installation.
# Edit this file if you want to change Hardcore Archive's default behavior.
#
# Precedence, lowest to highest:
#   1. this file
#   2. ~/.config/hardcore-archive/config
#      macOS: ~/Library/Application Support/hardcore-archive/config
#   3. --config FILE
#   4. command-line options
#
# --no-config ignores layers 2 and 3, but this file always remains the base
# configuration. Hardcore Archive never edits this file automatically.

# Transformations ------------------------------------------------------------
# Safe transformations are ON by default. Each lane has its own validation and
# keeps the original whenever a candidate is invalid, unsafe, or not smaller
# where a size win is required. Source deletion remains explicit/opt-in.
VIDEO_TRANSCODE=true
IMAGE_OPTIMIZE=true
NESTED_REPACK=true
CONTAINER_REPACK=true

# Core archive policy --------------------------------------------------------
EFFORT=extreme
# Default verification checks the 7-Zip streams/CRC and exact archive-path
# completeness without extracting payloads again or comparing content hashes.
# Use VERIFY_MODE=hashes or VERIFY_MODE=extract for explicit SHA-256 verification.
VERIFY_MODE=integrity
RESUME=true
WRITE_REPORT=true
CROSS_FILESYSTEMS=false
PROGRESS_INTERVAL=15
MC_AUTO=true

# Post-run -------------------------------------------------------------------
# Power off only after a fully successful create/batch job. Diagnostic,
# read-only, analyze-only, and failed runs never power the machine off.
POWER_OFF_ON_SUCCESS=false

# Video ----------------------------------------------------------------------
# Used only when VIDEO_TRANSCODE=true and this source contains relevant video.
# auto compares every working hardware AV1/HEVC candidate per video and keeps
# the smallest one that meets the same quality and minimum-savings requirements.
# Set av1 or hevc to force a codec globally.
VIDEO_CODEC=auto
VIDEO_MODE=balanced
# Minimum accepted VMAF score for video candidates. Range: 0..100.
# Higher values preserve more visual quality but usually reduce compression.
# Set QUALITY_CHECK=off to disable sample quality checks.
QUALITY_CHECK=92
VIDEO_MIN_SAVINGS_PERCENT=3
VIDEO_PREFLIGHT=true
VIDEO_SCALE=true
VIDEO_DENOISE=true

# Image ----------------------------------------------------------------------
# Used only when IMAGE_OPTIMIZE=true and this source contains relevant images.
IMAGE_MODE=maximum
IMAGE_JOBS=auto

# Nested archives ------------------------------------------------------------
# True archive files (.zip/.7z/.rar/etc.) may be recursively unpacked and
# rebuilt as a smaller validated .7z replacement.
NESTED_MAX_DEPTH=3

# Format-preserving application containers ----------------------------------
# DOCX/XLSX/PPTX, ODF, EPUB, NPZ, WHL, JAR, and WAR keep the SAME filename and
# file type after extraction. Rebuilt candidates are payload-validated and are
# used only when smaller. Signed containers are preserved unchanged.

# Batch ----------------------------------------------------------------------
BATCH_ROOT_FILES=archive
BATCH_JOBS=auto

# Manual overrides -----------------------------------------------------------
# DICTIONARY=1g
# THREADS=2
# SEARCH_CYCLES=500
# WORK_DIR=/path/to/work

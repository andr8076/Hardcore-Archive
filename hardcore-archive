#!/usr/bin/env bash

# Hardcore Archive public entrypoint.
if [[ -z ${BASH_VERSION:-} || ${BASH_VERSINFO[0]:-0} -lt 4 || ( ${BASH_VERSINFO[0]:-0} -eq 4 && ${BASH_VERSINFO[1]:-0} -lt 2 ) ]]; then
    printf 'Error: hardcore-archive requires Bash 4.2 or newer.\n' >&2
    exit 1
fi
set -Eeuo pipefail
IFS=$'\n\t'

HARDCORE_ARCHIVE_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
export HARDCORE_ARCHIVE_ROOT
# shellcheck source=/dev/null
source "$HARDCORE_ARCHIVE_ROOT/lib/common.sh"
# shellcheck source=/dev/null
source "$HARDCORE_ARCHIVE_ROOT/lib/platform.sh"
# shellcheck source=/dev/null
source "$HARDCORE_ARCHIVE_ROOT/lib/config.sh"
# shellcheck source=/dev/null
source "$HARDCORE_ARCHIVE_ROOT/lib/visual.sh"
# Keep read-only inspection out of the long-running visual/archive launcher.
# This also gives inspection one small, pipefail-safe implementation.
if [[ ${1:-} == --inspect ]]; then
    # shellcheck source=/dev/null
    source "$HARDCORE_ARCHIVE_ROOT/lib/inspect.sh"
    hardcore_inspect_main "$@"
    exit $?
fi
hardcore_visual_launcher_main "$@"

# Hardcore Archive example configuration
# Copy to:
#   Linux: ~/.config/hardcore-archive/config
#   macOS: ~/Library/Application Support/hardcore-archive/config

# Preservation-first defaults. Set individual transformations to true only when
# you deliberately want the archived representation to differ from the source
# file bitstream.
VIDEO_TRANSCODE=false
IMAGE_OPTIMIZE=false
NESTED_REPACK=false

# Core archive policy
EFFORT=extreme
VERIFY_MODE=auto
RESUME=true
WRITE_REPORT=true
CROSS_FILESYSTEMS=false
PROGRESS_INTERVAL=15

# Video settings used only when VIDEO_TRANSCODE=true
VIDEO_CODEC=av1
VIDEO_MODE=balanced
VIDEO_MIN_SAVINGS_PERCENT=3
VIDEO_PREFLIGHT=true
VIDEO_SCALE=true
VIDEO_DENOISE=true
QUALITY_CHECK=auto

# Image settings used only when IMAGE_OPTIMIZE=true
IMAGE_MODE=maximum
IMAGE_JOBS=auto

# Nested archive settings used only when NESTED_REPACK=true
NESTED_MAX_DEPTH=3

# Batch defaults
BATCH_ROOT_FILES=archive
BATCH_JOBS=auto

# Optional manual overrides
# DICTIONARY=1g
# THREADS=2
# SEARCH_CYCLES=500
# MC_AUTO=true
# WORK_DIR=/path/to/work
